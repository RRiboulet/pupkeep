{
  "name": "Pupkeep",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "forwardPorts": [
    8787
  ],
  "portsAttributes": {
    "8787": {
      "label": "Pupkeep (HTTP)",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "PUPKEEP_DATA_DIR": "/tmp/pupkeep-dev",
    "PUPKEEP_PORT": "8787",
    "PUPKEEP_ACCESS": "lan",
    "PI_TRUE_COLOR": "1",
    "COLORTERM": "truecolor",
    "OPENCODE_API_KEY": "${localEnv:OPENCODE_API_KEY}",
    "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}",
    "BRAVE_API_KEY": "${localEnv:BRAVE_API_KEY}",
    "TYPESAFE_API_KEY": "${localEnv:TYPESAFE_API_KEY}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2.103.2"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": false
      }
    }
  },
  "remoteUser": "vscode"
}
