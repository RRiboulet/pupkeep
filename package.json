{
  "name": "pupkeep",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A shared, agent-operated puppy care app for two caregivers, hosted on a phone.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bin/pupkeep.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "backup": "node scripts/backup.ts",
    "restore": "node scripts/restore.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "@google/genai": false,
    "protobufjs": false
  }
}
