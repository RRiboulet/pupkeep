# Development only. The phone configures secrets in the app, not in this file.
# Copy to `.env`; `.env` is gitignored, this file is not.
PUPKEEP_DATA_DIR=/tmp/pupkeep-dev
PUPKEEP_PORT=8787
PUPKEEP_ACCESS=local
# Only for a VPS/Caddy deployment behind a public HTTPS origin.
# PUPKEEP_PUBLIC_ORIGIN=https://pupkeep.example
OPENCODE_API_KEY=
OPENROUTER_API_KEY=
